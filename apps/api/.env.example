# DIGI-MON API 환경변수 예시
#
# 사용법:
#   1) 이 파일을 복사: cp apps/api/.env.example apps/api/.env
#   2) 실제 값으로 채워서 사용 (apps/api/.env 는 .gitignore 처리됨)
#   3) Spring Boot 는 .env 를 자동 로드하지 않습니다. IDE Run Configuration,
#      docker-compose, 또는 셸 export 등을 통해 주입하세요.
#
# 주의: 비밀번호/자격증명/개인 절대경로 등 민감값은 절대 .env.example 에 기입 금지.

# ===== Spring =====
# 활성 프로필 (local, dev, prod 등)
SPRING_PROFILES_ACTIVE=local
# API 서버 포트
SERVER_PORT=8080

# ===== Database (PostgreSQL) =====
# JDBC URL (필수). 예: jdbc:postgresql://localhost:5432/digi-mon
DB_URL=
# DB 사용자명 (필수)
DB_USERNAME=
# DB 비밀번호 (필수)
DB_PASSWORD=

# ===== JPA =====
# Hibernate SQL 로그 출력 여부 (true/false)
JPA_SHOW_SQL=true

# ===== Firebase Admin SDK =====
# 서비스 어카운트 JSON "전체 내용" 을 주입합니다. (파일 경로 방식은 더 이상 지원하지 않음)
#
# [로컬 개발 권장 방식 - application-local.yml 직접 작성]
#   application-local.yml 에 아래 형태로 추가하세요. yml 의 블록 스칼라(|) 를
#   쓰면 JSON 의 개행을 그대로 보존할 수 있고, private_key 의 \n 은 서버가
#   자동으로 실제 개행으로 복원합니다.
#
#     firebase:
#       admin:
#         credential-json: |
#           {
#             "type": "service_account",
#             "project_id": "your-project",
#             "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
#             "client_email": "...",
#             ...
#           }
#
#   또는 한 줄 JSON 으로:
#     firebase:
#       admin:
#         credential-json: '{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", ...}'
#
# [운영/CI 환경 - 환경변수 주입]
#   FIREBASE_CREDENTIAL_JSON 환경변수에 JSON 전체를 한 줄로 넣어 주입합니다.
#   쿠버네티스 Secret, GitHub Actions secrets 등을 사용하세요.
#   값 만드는 예시(macOS/Linux):
#     export FIREBASE_CREDENTIAL_JSON="$(tr -d '\n' < /path/to/firebase-adminsdk.json)"
#
# 주의: 이 .env.example 에는 실제 JSON 을 절대 기입하지 마세요. (커밋되는 파일)
FIREBASE_CREDENTIAL_JSON=

# ===== AI Microservice (FastAPI) =====
# AI 서비스 base URL
DIGIMON_AI_BASE_URL=http://localhost:8000
# 호출 타임아웃 (ms)
DIGIMON_AI_TIMEOUT_MS=3000
# AI 연동 활성화 여부 (true/false)
DIGIMON_AI_ENABLED=false

# ===== Web / CORS =====
# 허용할 프론트엔드 origin. 여러 개는 콤마로 구분
# 예: http://localhost:3000,https://digi-mon.example.com
WEB_CORS_ALLOWED_ORIGINS=http://localhost:3000
